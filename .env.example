# Meta Messenger Webhook Server Configuration

# Application Port
PORT=3000

# Meta Messenger Webhook Verification Token (set in Meta Developer Dashboard)
MESSENGER_VERIFY_TOKEN=your_verify_token_here

# Meta App Secret (used to verify incoming x-hub-signature-256 header)
MESSENGER_APP_SECRET=your_app_secret_here

# Meta Page Access Token (used to send messages via Messenger Send API)
MESSENGER_PAGE_ACCESS_TOKEN=your_page_access_token_here

